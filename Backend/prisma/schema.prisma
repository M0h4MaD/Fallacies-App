// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum FallacyCategory {
  formal
  informal
}

enum FallacySubCategory {
  relevance
  ambiguity
  presumption
  weak_induction @map("weak_induction")
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum ExampleContext {
  political
  religious
  media
  everyday
}

enum QuizMode {
  scenario
  correction
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique
  guestId        String?  @unique
  isGuest        Boolean  @default(true)
  displayName    String
  email          String?
  role           Role     @default(user)
  xp             Int      @default(0)
  level          Int      @default(1)
  streakCurrent  Int      @default(0)
  streakLongest  Int      @default(0)
  lastActiveDate String?
  badgeIds       String[] @default([])
  isSuspended    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unlockedFallacies Fallacy[]  @relation("UnlockedFallacies")
  quizzes           Quiz[]
  progress          Progress[]
  reports           Report[]

  @@index([xp(sort: Desc)])
  @@index([streakCurrent(sort: Desc)])
}

model Fallacy {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  nameAr                 String
  nameEn                 String
  category               FallacyCategory
  subCategory            FallacySubCategory
  difficulty             Difficulty
  definitionAr           String
  definitionEn           String
  historicalBackgroundAr String?
  historicalBackgroundEn String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  commonness             Int                @default(3)
  examples               FallacyExample[]
  unlockedByUsers        User[]             @relation("UnlockedFallacies")
  quizAnswers            QuizAnswer[]
  progress               Progress[]

  generatedQuestions GeneratedQuestion[]
}

model FallacyExample {
  id                   String         @id @default(cuid())
  fallacyId            String
  fallacy              Fallacy        @relation(fields: [fallacyId], references: [id], onDelete: Cascade)
  context              ExampleContext
  textAr               String
  textEn               String
  isFictionalComposite Boolean
  sourceCitation       String?
}

model Quiz {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  mode         QuizMode
  scorePercent Int
  xpAwarded    Int
  timeSpentSec Int
  createdAt    DateTime @default(now())

  answers QuizAnswer[]

  @@index([userId, createdAt(sort: Desc)])
}

model QuizAnswer {
  id             String     @id @default(cuid())
  quizId         String
  quiz           Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  fallacyId      String
  fallacy        Fallacy    @relation(fields: [fallacyId], references: [id])
  difficultyTier Difficulty
  wasCorrect     Boolean
  hintUsed       Boolean    @default(false)
}

model Progress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  fallacyId      String
  fallacy        Fallacy   @relation(fields: [fallacyId], references: [id])
  timesCorrect   Int       @default(0)
  timesIncorrect Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewDue  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewIntervalIndex Int @default(0) // index into the 1/3/7-day interval ladder

  @@unique([userId, fallacyId])
  @@index([userId, nextReviewDue])
}

model GeneratedQuestion {
  id             String         @id @default(cuid())
  fallacyId      String
  fallacy        Fallacy        @relation(fields: [fallacyId], references: [id], onDelete: Cascade)
  difficultyTier Difficulty
  mode           QuizMode
  contextType    ExampleContext
  textAr         String
  textEn         String
  createdAt      DateTime       @default(now())

  shownTo ShownQuestion[]

  @@index([fallacyId, difficultyTier, mode])
}

model ShownQuestion {
  id         String            @id @default(cuid())
  userId     String
  questionId String
  question   GeneratedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  shownAt    DateTime          @default(now())

  @@index([userId, questionId])
}

model DailyQuota {
  id        String @id @default(cuid())
  userId    String
  date      String // 'YYYY-MM-DD'
  callCount Int    @default(0)

  @@unique([userId, date])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  contentType String // 'question' | 'debater_message' | 'evaluator_feedback'
  contentText String
  reason      String?
  createdAt   DateTime @default(now())
}
